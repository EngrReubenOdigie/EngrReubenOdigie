CREATE OR REPLACE FUNCTION "public"."post_wealth_transaction"(
    "p_user_id" "uuid",
    "p_transaction_date" "date",
    "p_transaction_type" "text",
    "p_amount" numeric,
    "p_currency" "text" DEFAULT 'NGN'::"text",
    "p_asset_name" "text" DEFAULT NULL::"text",
    "p_ticker" "text" DEFAULT NULL::"text",
    "p_category" "text" DEFAULT NULL::"text",
    "p_description" "text" DEFAULT NULL::"text",
    "p_quantity" numeric DEFAULT NULL::numeric,
    "p_unit_price" numeric DEFAULT NULL::numeric,
    "p_account_name" "text" DEFAULT NULL::"text",
    "p_reference" "text" DEFAULT NULL::"text",
    "p_source" "text" DEFAULT 'wealth_os'::"text",
    "p_source_id" "text" DEFAULT NULL::"text",
    "p_notes" "text" DEFAULT NULL::"text",
    "p_target_account_name" "text" DEFAULT NULL::"text",
    "p_thrift_id" "uuid" DEFAULT NULL::"uuid",
    "p_market" "text" DEFAULT NULL::"text",
    "p_asset_type" "text" DEFAULT NULL::"text"
)
RETURNS "uuid"
LANGUAGE "plpgsql"
SET "search_path" TO 'public'
AS $$
DECLARE
    v_transaction_id uuid;
    v_cash_id uuid;
    v_cash_balance numeric;
    v_target_cash_id uuid;
    v_account_id uuid;
    v_target_account_id uuid;
    v_investment_id uuid;
    v_existing_quantity numeric;
    v_existing_cost_basis numeric;
    v_existing_average_cost numeric;
    v_new_quantity numeric;
    v_new_cost_basis numeric;
    v_sale_cost_basis numeric;
    v_realized_gain_loss numeric;
    v_cooperative_id uuid;
    v_reference_exists boolean;
BEGIN
    IF p_user_id IS NULL THEN RAISE EXCEPTION 'User ID is required'; END IF;
    IF p_transaction_date IS NULL THEN RAISE EXCEPTION 'Transaction date is required'; END IF;
    IF p_transaction_type IS NULL OR trim(p_transaction_type) = '' THEN RAISE EXCEPTION 'Transaction type is required'; END IF;
    IF p_amount IS NULL OR p_amount <= 0 THEN RAISE EXCEPTION 'Transaction amount must be greater than zero'; END IF;
    IF p_currency IS NULL OR trim(p_currency) = '' THEN RAISE EXCEPTION 'Currency is required'; END IF;

    p_transaction_type := upper(trim(p_transaction_type));
    p_currency := upper(trim(p_currency));

    IF p_transaction_type NOT IN (
        'ACCOUNT_FUNDING',
        'INCOME',
        'EXPENSE',
        'SAVING',
        'TRANSFER',
        'INVESTMENT_BUY',
        'INVESTMENT_SELL',
        'DIVIDEND',
        'INTEREST',
        'COOPERATIVE_CONTRIBUTION',
        'PENSION_CONTRIBUTION'
    ) THEN
        RAISE EXCEPTION 'Unsupported transaction type: %', p_transaction_type;
    END IF;

    IF p_reference IS NOT NULL AND trim(p_reference) <> '' THEN
        SELECT EXISTS (
            SELECT 1
            FROM public.transactions t
            WHERE t.user_id = p_user_id
              AND t.reference = trim(p_reference)
        ) INTO v_reference_exists;

        IF v_reference_exists THEN
            RAISE EXCEPTION 'Transaction reference already exists: %', p_reference;
        END IF;
    END IF;

    -- Resolve master account IDs without creating phantom cash accounts.
    IF p_account_name IS NOT NULL AND trim(p_account_name) <> '' THEN
        SELECT id INTO v_account_id
        FROM public.wealth_accounts
        WHERE user_id = p_user_id
          AND account_name = trim(p_account_name)
          AND currency = p_currency
          AND is_active = true
        LIMIT 1;
    END IF;

    IF p_target_account_name IS NOT NULL AND trim(p_target_account_name) <> '' THEN
        SELECT id INTO v_target_account_id
        FROM public.wealth_accounts
        WHERE user_id = p_user_id
          AND account_name = trim(p_target_account_name)
          AND currency = p_currency
          AND is_active = true
        LIMIT 1;
    END IF;

    -- Any transaction type that moves cash must reference a real master account.
    IF p_transaction_type IN (
        'ACCOUNT_FUNDING',
        'INCOME',
        'EXPENSE',
        'SAVING',
        'INVESTMENT_BUY',
        'INVESTMENT_SELL',
        'DIVIDEND',
        'INTEREST',
        'COOPERATIVE_CONTRIBUTION'
    ) THEN
        IF p_account_name IS NULL OR trim(p_account_name) = '' THEN
            RAISE EXCEPTION 'Cash account is required for %', p_transaction_type;
        END IF;

        IF v_account_id IS NULL THEN
            RAISE EXCEPTION 'Master cash account not found or inactive: %', p_account_name;
        END IF;
    END IF;

    -- ACCOUNT_FUNDING adds money to an existing master account.
    -- It is deliberately NOT income and NOT a transfer.
    IF p_transaction_type = 'ACCOUNT_FUNDING' THEN
        IF p_account_name IS NULL OR trim(p_account_name) = '' THEN
            RAISE EXCEPTION 'Cash account is required for ACCOUNT_FUNDING';
        END IF;

        IF p_target_account_name IS NOT NULL
           AND trim(p_target_account_name) <> '' THEN
            RAISE EXCEPTION 'ACCOUNT_FUNDING cannot have a target account';
        END IF;

        IF v_account_id IS NULL THEN
            RAISE EXCEPTION 'Master cash account not found or inactive: %', p_account_name;
        END IF;

        SELECT id INTO v_cash_id
        FROM public.cash_balances
        WHERE user_id = p_user_id
          AND balance_name = trim(p_account_name)
          AND currency = p_currency
          AND is_active = true
        FOR UPDATE;

        IF v_cash_id IS NULL THEN
            RAISE EXCEPTION 'Cash balance not found: %', p_account_name;
        END IF;

        UPDATE public.cash_balances
        SET balance = balance + p_amount,
            updated_at = now()
        WHERE id = v_cash_id;
    END IF;

    -- TRANSFER logic intentionally preserved.
    IF p_transaction_type = 'TRANSFER' THEN
        IF p_account_name IS NULL OR p_target_account_name IS NULL THEN
            RAISE EXCEPTION 'Source and target accounts are required';
        END IF;

        IF trim(p_account_name) = trim(p_target_account_name) THEN
            RAISE EXCEPTION 'Source and target accounts must be different';
        END IF;

        IF v_account_id IS NULL THEN
            RAISE EXCEPTION 'Source master cash account not found or inactive: %', p_account_name;
        END IF;

        IF v_target_account_id IS NULL THEN
            RAISE EXCEPTION 'Target master cash account not found or inactive: %', p_target_account_name;
        END IF;

        SELECT id, balance INTO v_cash_id, v_cash_balance
        FROM public.cash_balances
        WHERE user_id = p_user_id
          AND balance_name = trim(p_account_name)
          AND currency = p_currency
          AND is_active = true
        FOR UPDATE;

        IF v_cash_id IS NULL THEN
            RAISE EXCEPTION 'Source cash balance not found: %', p_account_name;
        END IF;

        IF v_cash_balance < p_amount THEN
            RAISE EXCEPTION 'Insufficient funds in %', p_account_name;
        END IF;

        SELECT id INTO v_target_cash_id
        FROM public.cash_balances
        WHERE user_id = p_user_id
          AND balance_name = trim(p_target_account_name)
          AND currency = p_currency
          AND is_active = true
        FOR UPDATE;

        IF v_target_cash_id IS NULL THEN
            RAISE EXCEPTION 'Target cash balance not found: %', p_target_account_name;
        END IF;

        UPDATE public.cash_balances
        SET balance = balance - p_amount,
            updated_at = now()
        WHERE id = v_cash_id;

        UPDATE public.cash_balances
        SET balance = balance + p_amount,
            updated_at = now()
        WHERE id = v_target_cash_id;
    END IF;

    IF p_transaction_type = 'EXPENSE' THEN
        SELECT id, balance INTO v_cash_id, v_cash_balance
        FROM public.cash_balances
        WHERE user_id = p_user_id
          AND balance_name = trim(p_account_name)
          AND currency = p_currency
          AND is_active = true
        FOR UPDATE;

        IF v_cash_id IS NULL THEN
            RAISE EXCEPTION 'Cash balance not found: %', p_account_name;
        END IF;

        IF v_cash_balance < p_amount THEN
            RAISE EXCEPTION 'Insufficient funds in %', p_account_name;
        END IF;

        UPDATE public.cash_balances
        SET balance = balance - p_amount,
            updated_at = now()
        WHERE id = v_cash_id;
    END IF;

    IF p_transaction_type IN ('INCOME','SAVING') THEN
        SELECT id INTO v_cash_id
        FROM public.cash_balances
        WHERE user_id = p_user_id
          AND balance_name = trim(p_account_name)
          AND currency = p_currency
          AND is_active = true
        FOR UPDATE;

        IF v_cash_id IS NULL THEN
            RAISE EXCEPTION 'Cash balance not found: %', p_account_name;
        END IF;

        UPDATE public.cash_balances
        SET balance = balance + p_amount,
            updated_at = now()
        WHERE id = v_cash_id;
    END IF;

    IF p_transaction_type = 'INVESTMENT_BUY' THEN
        IF p_asset_name IS NULL THEN RAISE EXCEPTION 'Asset name is required'; END IF;
        IF p_quantity IS NULL OR p_quantity <= 0 THEN RAISE EXCEPTION 'Quantity must be greater than zero'; END IF;
        IF p_unit_price IS NULL OR p_unit_price <= 0 THEN RAISE EXCEPTION 'Unit price must be greater than zero'; END IF;

        SELECT id, balance INTO v_cash_id, v_cash_balance
        FROM public.cash_balances
        WHERE user_id = p_user_id
          AND balance_name = trim(p_account_name)
          AND currency = p_currency
          AND is_active = true
        FOR UPDATE;

        IF v_cash_id IS NULL THEN
            RAISE EXCEPTION 'Cash balance not found: %', p_account_name;
        END IF;

        IF v_cash_balance < p_amount THEN
            RAISE EXCEPTION 'Insufficient funds in %', p_account_name;
        END IF;

        UPDATE public.cash_balances
        SET balance = balance - p_amount,
            updated_at = now()
        WHERE id = v_cash_id;

        SELECT id, quantity, cost_basis, average_cost
        INTO v_investment_id, v_existing_quantity, v_existing_cost_basis, v_existing_average_cost
        FROM public.investments
        WHERE user_id = p_user_id
          AND (
              (p_ticker IS NOT NULL AND ticker = p_ticker)
              OR
              (p_ticker IS NULL AND asset_name = p_asset_name)
          )
          AND currency = p_currency
          AND is_active = true
        ORDER BY created_at
        LIMIT 1
        FOR UPDATE;

        IF v_investment_id IS NULL THEN
            INSERT INTO public.investments (
                user_id, asset_name, ticker, asset_type, market, currency,
                quantity, average_cost, cost_basis, current_price, current_value,
                unrealized_gain_loss, realized_gain_loss, price_source,
                last_price_update, is_active
            )
            VALUES (
                p_user_id, p_asset_name, p_ticker,
                COALESCE(p_asset_type,'Investment'), p_market, p_currency,
                p_quantity, p_unit_price, p_amount, p_unit_price,
                p_quantity * p_unit_price, 0, 0, 'manual', now(), true
            )
            RETURNING id INTO v_investment_id;
        ELSE
            v_new_quantity := COALESCE(v_existing_quantity,0) + p_quantity;
            v_new_cost_basis := COALESCE(v_existing_cost_basis,0) + p_amount;

            UPDATE public.investments
            SET quantity = v_new_quantity,
                cost_basis = v_new_cost_basis,
                average_cost = CASE
                    WHEN v_new_quantity > 0
                    THEN v_new_cost_basis / v_new_quantity
                    ELSE 0
                END,
                current_price = p_unit_price,
                current_value = v_new_quantity * p_unit_price,
                unrealized_gain_loss = (v_new_quantity * p_unit_price) - v_new_cost_basis,
                price_source = 'manual',
                last_price_update = now(),
                updated_at = now()
            WHERE id = v_investment_id;
        END IF;
    END IF;

    IF p_transaction_type = 'INVESTMENT_SELL' THEN
        IF p_quantity IS NULL OR p_quantity <= 0 THEN
            RAISE EXCEPTION 'Quantity sold must be greater than zero';
        END IF;

        IF p_unit_price IS NULL OR p_unit_price <= 0 THEN
            RAISE EXCEPTION 'Sale price must be greater than zero';
        END IF;

        SELECT id, quantity, cost_basis, average_cost
        INTO v_investment_id, v_existing_quantity, v_existing_cost_basis, v_existing_average_cost
        FROM public.investments
        WHERE user_id = p_user_id
          AND (
              (p_ticker IS NOT NULL AND ticker = p_ticker)
              OR
              (p_ticker IS NULL AND asset_name = p_asset_name)
          )
          AND currency = p_currency
          AND is_active = true
        ORDER BY created_at
        LIMIT 1
        FOR UPDATE;

        IF v_investment_id IS NULL THEN
            RAISE EXCEPTION 'Investment position not found';
        END IF;

        IF v_existing_quantity < p_quantity THEN
            RAISE EXCEPTION 'Insufficient investment quantity';
        END IF;

        v_sale_cost_basis := p_quantity * v_existing_average_cost;
        v_realized_gain_loss := p_amount - v_sale_cost_basis;
        v_new_quantity := v_existing_quantity - p_quantity;
        v_new_cost_basis := v_existing_cost_basis - v_sale_cost_basis;

        UPDATE public.investments
        SET quantity = GREATEST(v_new_quantity,0),
            cost_basis = GREATEST(v_new_cost_basis,0),
            current_price = p_unit_price,
            current_value = GREATEST(v_new_quantity,0) * p_unit_price,
            realized_gain_loss = COALESCE(realized_gain_loss,0) + v_realized_gain_loss,
            unrealized_gain_loss =
                (GREATEST(v_new_quantity,0) * p_unit_price)
                - GREATEST(v_new_cost_basis,0),
            price_source = 'manual',
            last_price_update = now(),
            is_active = v_new_quantity > 0,
            updated_at = now()
        WHERE id = v_investment_id;

        SELECT id INTO v_cash_id
        FROM public.cash_balances
        WHERE user_id = p_user_id
          AND balance_name = trim(p_account_name)
          AND currency = p_currency
          AND is_active = true
        FOR UPDATE;

        IF v_cash_id IS NULL THEN
            RAISE EXCEPTION 'Cash balance not found: %', p_account_name;
        END IF;

        UPDATE public.cash_balances
        SET balance = balance + p_amount,
            updated_at = now()
        WHERE id = v_cash_id;
    END IF;

    IF p_transaction_type IN ('DIVIDEND','INTEREST') THEN
        SELECT id INTO v_cash_id
        FROM public.cash_balances
        WHERE user_id = p_user_id
          AND balance_name = trim(p_account_name)
          AND currency = p_currency
          AND is_active = true
        FOR UPDATE;

        IF v_cash_id IS NULL THEN
            RAISE EXCEPTION 'Cash balance not found: %', p_account_name;
        END IF;

        UPDATE public.cash_balances
        SET balance = balance + p_amount,
            updated_at = now()
        WHERE id = v_cash_id;
    END IF;

    IF p_transaction_type = 'COOPERATIVE_CONTRIBUTION' THEN
        IF p_asset_name IS NULL OR trim(p_asset_name) = '' THEN
            RAISE EXCEPTION 'Cooperative name is required';
        END IF;

        SELECT id, balance
        INTO v_cash_id, v_cash_balance
        FROM public.cash_balances
        WHERE user_id = p_user_id
          AND balance_name = trim(p_account_name)
          AND currency = p_currency
          AND is_active = true
        FOR UPDATE;

        IF v_cash_id IS NULL THEN
            RAISE EXCEPTION 'Cash balance not found: %', p_account_name;
        END IF;

        IF v_cash_balance < p_amount THEN
            RAISE EXCEPTION 'Insufficient funds in %', p_account_name;
        END IF;

        UPDATE public.cash_balances
        SET balance = balance - p_amount,
            updated_at = now()
        WHERE id = v_cash_id;

        SELECT id INTO v_cooperative_id
        FROM public.cooperatives
        WHERE user_id = p_user_id
          AND cooperative_name = trim(p_asset_name)
          AND currency = p_currency
          AND lower(status) = 'active'
        LIMIT 1
        FOR UPDATE;

        IF v_cooperative_id IS NULL THEN
            INSERT INTO public.cooperatives (
                user_id, cooperative_name, balance, currency, status,
                reconciliation_status, notes
            )
            VALUES (
                p_user_id, trim(p_asset_name), p_amount, p_currency,
                'active', 'pending',
                'Created by Wealth OS transaction engine'
            )
            RETURNING id INTO v_cooperative_id;
        ELSE
            UPDATE public.cooperatives
            SET balance = balance + p_amount,
                updated_at = now()
            WHERE id = v_cooperative_id;
        END IF;
    END IF;

    -- Pension contribution deliberately changes transaction history only
    -- until pension schema is confirmed.
    INSERT INTO public.transactions (
        user_id, transaction_date, transaction_type, asset_name, ticker,
        category, description, amount, currency, quantity, unit_price,
        account_name, account_id, target_account_id, cooperative_id,
        reference, source, source_id, reconciliation_status, notes,
        thrift_id, created_at, updated_at
    )
    VALUES (
        p_user_id, p_transaction_date, p_transaction_type, p_asset_name,
        p_ticker, p_category, p_description, p_amount, p_currency,
        p_quantity, p_unit_price, trim(p_account_name), v_account_id,
        v_target_account_id, v_cooperative_id,
        NULLIF(trim(p_reference), ''), p_source, p_source_id, 'pending',
        p_notes, p_thrift_id, now(), now()
    )
    RETURNING id INTO v_transaction_id;

    RETURN v_transaction_id;
END;
$$;

ALTER FUNCTION "public"."post_wealth_transaction"(
    "p_user_id" "uuid",
    "p_transaction_date" "date",
    "p_transaction_type" "text",
    "p_amount" numeric,
    "p_currency" "text",
    "p_asset_name" "text",
    "p_ticker" "text",
    "p_category" "text",
    "p_description" "text",
    "p_quantity" numeric,
    "p_unit_price" numeric,
    "p_account_name" "text",
    "p_reference" "text",
    "p_source" "text",
    "p_source_id" "text",
    "p_notes" "text",
    "p_target_account_name" "text",
    "p_thrift_id" "uuid",
    "p_market" "text",
    "p_asset_type" "text"
) OWNER TO "postgres";
